# ============================================================
# BrentDesk environment configuration
# Copy to .env and fill in real values. NEVER commit real secrets.
# Publication identity (name, domain, socials) lives in
# shared/publication.ts — BASE_URL below overrides the canonical
# site URL at runtime (useful for staging).
# ============================================================

# --- Required ---
DATABASE_URL=mysql://user:password@localhost:3306/brentdesk
JWT_SECRET=change-me-to-a-long-random-string

# --- Core runtime ---
NODE_ENV=development
PORT=3000
# Overrides publication.siteUrl for canonical/sitemap/link generation
BASE_URL=
# Public host used when a request context is unavailable (e.g. cron)
PUBLIC_HOST=
# Extra apex hosts that resolve to the public site (comma-separated),
# e.g. a separate talent-platform domain
TENANT_APEX_HOSTS=

# --- Database bootstrap (docker-compose only) ---
DB_ROOT_PASSWORD=
DB_NAME=brentdesk
DB_USER=brentdesk
DB_PASSWORD=

# --- Cache / sessions ---
REDIS_URL=redis://localhost:6379

# --- Media storage (S3-compatible; R2 supported via S3_ENDPOINT) ---
S3_ENDPOINT=
S3_BUCKET=brentdesk-media
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public CDN base for uploaded media, e.g. https://assets.example.com
S3_PUBLIC_URL=
MEDIA_BUCKET_URL=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
ADMIN_NOTIFY_EMAIL=
MEDIA_NOTIFY_EMAIL=

# --- AI providers (all optional; configure in Admin → Integrations instead
#     where possible — DB-stored config takes precedence) ---
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
OPENAI_API_KEY=

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Integration secret encryption (required if using Admin → Integrations) ---
INTEGRATION_SECRETS_KEY=

# --- Google services ---
GOOGLE_INDEXING_SERVICE_ACCOUNT=

# --- Talent platform (optional) ---
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_OAUTH_REDIRECT_URI=
GITHUB_TOKEN_ENC_KEY=
JUDGE0_BASE_URL=
JUDGE0_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=
GREENHOUSE_API_KEY=
SLACK_WEBHOOK_URL=

# --- Advertising ---
# AdSense publisher id (without the "ca-" prefix), e.g. pub-0000000000000000
ADSENSE_PUBLISHER_ID=

# --- Analytics (Umami; injected at build into client) ---
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# --- Migrations ---
# Set to 1 to allow the full migration chain to run at startup on a
# non-empty database (normally only the additive tail runs)
RUN_STARTUP_MIGRATIONS=
SKIP_STARTUP_MIGRATIONS=

# --- Bootstrap seed ---
# Set to 1 to run the idempotent system-data seed once the server is up
# (countries, editions, categories, sectors, roles, ad slots, homepage
# sections). Intended for a first deploy on a platform with no usable
# container shell; safe to leave set, but it can be removed afterwards.
# Seeds no editorial content.
SEED_ON_BOOT=
# Creates an admin login on the first seed run. Set both, deploy, then
# unset them and rotate the password from the admin UI.
ADMIN_EMAIL=
ADMIN_PASSWORD=
